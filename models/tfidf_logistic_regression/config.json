{
  "experiment": "TF-IDF + Logistic Regression baseline",
  "dataset": "data/final_datasets/merged_severity_dataset_not_keyword_keyword.csv",
  "text_column": "content",
  "target_column": "severity",
  "label_mapping": {
    "severity_0": "0 = Non-Crisis",
    "severity_1": "1 = Implicit Crisis",
    "severity_2_to_6": "2 = Explicit Crisis"
  },
  "label_names": [
    "Non-Crisis",
    "Implicit Crisis",
    "Explicit Crisis"
  ],
  "excluded_from_features": [
    "severity",
    "gpt_label",
    "claude_label",
    "gemini_label",
    "llama_label",
    "mistral_label",
    "url",
    "author",
    "created"
  ],
  "seed": 42,
  "split": {
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15,
    "stratified": true,
    "random_state": 42,
    "n_train": 905,
    "n_val": 194,
    "n_test": 195
  },
  "duplicates": {
    "total_rows": 1294,
    "duplicate_rows": 0,
    "duplicate_content": 0,
    "rows_removed": 0,
    "rows_remaining": 1294
  },
  "tfidf": {
    "analyzer": "char_wb",
    "ngram_range": [
      3,
      5
    ],
    "min_df": 2,
    "max_df": 0.9,
    "sublinear_tf": true,
    "max_features": 50000,
    "lowercase": true,
    "strip_accents": "unicode",
    "n_features_fitted": 17708,
    "fitted_on": "training split only"
  },
  "logistic_regression": {
    "C": 1.0,
    "class_weight": "balanced",
    "solver": "lbfgs",
    "max_iter": 5000,
    "random_state": 42,
    "n_iter_used": 20
  },
  "selection_metric": "validation macro F1",
  "test_metrics": {
    "accuracy": 0.7128,
    "macro_precision": 0.7007,
    "macro_recall": 0.6979,
    "macro_f1": 0.6962,
    "weighted_precision": 0.7155,
    "weighted_recall": 0.7128,
    "weighted_f1": 0.7117
  }
}